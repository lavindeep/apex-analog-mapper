<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>ApexMapper.App</RootNamespace>
    <AssemblyName>ApexMapper</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="NHotkey.Wpf" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="TaskScheduler" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="OxyPlot.Wpf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApexMapper.Core\ApexMapper.Core.csproj" />
    <ProjectReference Include="..\ApexMapper.Persistence\ApexMapper.Persistence.csproj" />
    <ProjectReference Include="..\ApexMapper.Logging\ApexMapper.Logging.csproj" />
    <ProjectReference Include="..\ApexMapper.Input\ApexMapper.Input.csproj" />
    <ProjectReference Include="..\ApexMapper.Output\ApexMapper.Output.csproj" />
    <ProjectReference Include="..\ApexMapper.Input.Abstractions\ApexMapper.Input.Abstractions.csproj" />
    <ProjectReference Include="..\ApexMapper.Profiles\ApexMapper.Profiles.csproj" />
    <!-- Build-order + copy-local only: the App never references supervisor types,
         but ApexMapper.Supervisor.exe must land next to ApexMapper.exe so the
         launcher can spawn it. -->
    <ProjectReference Include="..\ApexMapper.Supervisor\ApexMapper.Supervisor.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
