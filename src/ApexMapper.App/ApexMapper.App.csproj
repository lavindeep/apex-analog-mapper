<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>ApexMapper.App</RootNamespace>
    <AssemblyName>ApexAnalogMapper</AssemblyName>
    <StartupObject>ApexMapper.App.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/app.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ApexMapper.Windows\ApexMapper.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ApexMapper.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Program.Main starts the app after Velopack and the single-instance check, so App.xaml must not generate a Main of its own. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
</Project>
