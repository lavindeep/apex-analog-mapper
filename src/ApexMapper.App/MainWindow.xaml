<ui:FluentWindow x:Class="ApexMapper.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Apex Analog Mapper"
                 Width="720" Height="560" MinWidth="560" MinHeight="400"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="Apex Analog Mapper" />
    <StackPanel Grid.Row="1" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center">
      <ui:TextBlock FontTypography="Title" Text="Toolchain proof" HorizontalAlignment="Center" />
      <ui:TextBlock Margin="0,8,0,16" Appearance="Secondary" HorizontalAlignment="Center"
                    Text="WPF-UI on .NET 10, packaged by Velopack." />
      <ui:Button Content="Close" Appearance="Primary" HorizontalAlignment="Center" Click="OnCloseClick" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>
