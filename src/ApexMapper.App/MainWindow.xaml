<ui:FluentWindow x:Class="ApexMapper.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:ApexMapper.App.Views"
                 xmlns:vm="clr-namespace:ApexMapper.App.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:MainViewModel}"
                 Title="Apex Analog Mapper"
                 Icon="pack://application:,,,/ApexAnalogMapper;component/Assets/app.ico"
                 Width="900" Height="900" MinWidth="640" MinHeight="480"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="Apex Analog Mapper">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/ApexAnalogMapper;component/Assets/app.ico" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,4,24,24" MaxWidth="920">
        <views:StatusCard DataContext="{Binding Status}" />
        <views:KeyboardCard DataContext="{Binding Keyboard}" Margin="0,12,0,0" />
        <views:GameCard DataContext="{Binding Game}" Margin="0,8,0,0" />
        <views:ProfileCard DataContext="{Binding Profile}" Margin="0,8,0,0" />
        <views:CalibrationCard x:Name="CalibrationCard" DataContext="{Binding Calibration}" Margin="0,8,0,0" />
        <views:SetupCard DataContext="{Binding Setup}" Margin="0,8,0,0" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</ui:FluentWindow>
