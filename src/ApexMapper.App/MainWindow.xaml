<Window x:Class="ApexMapper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:profilesVm="clr-namespace:ApexMapper.App.ViewModels.Profiles"
        xmlns:devicesVm="clr-namespace:ApexMapper.App.ViewModels.Devices"
        xmlns:profilesViews="clr-namespace:ApexMapper.App.Views.Profiles"
        xmlns:devicesViews="clr-namespace:ApexMapper.App.Views.Devices"
        Title="Apex Analog Mapper" Height="680" Width="920" MinHeight="520" MinWidth="740"
        WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type profilesVm:ProfileSelectorViewModel}">
            <profilesViews:ProfileSelectorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type devicesVm:DevicePickerViewModel}">
            <devicesViews:DevicePickerView />
        </DataTemplate>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,28,30,24">
            <TextBlock Text="Apex Analog Mapper" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,18" DataContext="{Binding TrayMenuViewModel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,22,0" VerticalAlignment="Center">
                        <TextBlock FontSize="22" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Stopped" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                            <Setter Property="Text" Value="Running" />
                                            <Setter Property="Foreground" Value="#18724A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Notice}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Notice}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" MinWidth="144">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Content" Value="Start" />
                                <Setter Property="Command" Value="{Binding ToggleEnabledCommand}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                        <Setter Property="Content" Value="Stop" />
                                        <Setter Property="Command" Value="{Binding PanicCommand}" />
                                        <Setter Property="ToolTip" Value="Ctrl+Alt+F12" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18" DataContext="{Binding GamePickerViewModel}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Game" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}"
                                AutomationProperties.Name="Refresh games" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                                  MaxDropDownHeight="320" AutomationProperties.Name="Game"
                                  ToolTip="{Binding SelectedGame.DisplayName}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Choose a game" VerticalAlignment="Center" Margin="14,0,40,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedGame}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="{Binding Notice}" Margin="0,9,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Notice}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <ContentControl Content="{Binding DevicePickerViewModel}" />
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <ContentControl Content="{Binding ProfileSelectorViewModel}" />
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
