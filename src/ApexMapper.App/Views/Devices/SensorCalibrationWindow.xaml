<Window x:Class="ApexMapper.App.Views.Devices.SensorCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calibrate keys" Width="720" Height="430" MinWidth="640" MinHeight="320"
        WindowStartupLocation="CenterOwner" Background="#F5F7FA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Calibrate keys" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,12,0,18" TextWrapping="Wrap"
                   Text="Release a key and click Set released. Hold it fully down and click Set fully pressed." />
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ProgressBar Grid.Column="1" Value="{Binding TravelPercent, Mode=OneWay}" Maximum="100" Height="12"
                                         IsEnabled="{Binding IsLive}" Margin="0,0,18,0" AutomationProperties.Name="Key input" />
                            <Button Grid.Column="2" Content="{Binding ReleasedLabel}" Command="{Binding SetReleasedCommand}"
                                    IsEnabled="{Binding IsLive}" Margin="0,0,8,0" />
                            <Button Grid.Column="3" Content="{Binding PressedLabel}" Command="{Binding SetPressedCommand}"
                                    IsEnabled="{Binding IsLive}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock Grid.Row="3" Text="{Binding Error}" Foreground="#A63828" TextWrapping="Wrap" Margin="0,12,0,0" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,10,0" />
            <Button Content="Save" Click="Save" MinWidth="90" />
        </StackPanel>
    </Grid>
</Window>
