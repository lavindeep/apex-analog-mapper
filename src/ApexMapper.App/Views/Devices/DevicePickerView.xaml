<UserControl x:Class="ApexMapper.App.Views.Devices.DevicePickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ConnectedChoice" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="IsEnabled" Value="{Binding IsConnected}" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Keyboard" Style="{StaticResource SectionTitle}" />
        <ComboBox ItemsSource="{Binding KeyboardGroups}" SelectedItem="{Binding SelectedKeyboard, Mode=TwoWay}"
                  ItemContainerStyle="{StaticResource ConnectedChoice}"
                  DisplayMemberPath="DisplayName" Margin="0,9,0,0" AutomationProperties.Name="Keyboard" />
        <TextBlock Text="Disconnected" Foreground="#9A421A" FontSize="13" Margin="0,9,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedKeyboard.IsConnected}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="No keyboards found" Margin="0,9,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding KeyboardGroups.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Expander Header="Advanced" Margin="0,18,0,0">
            <StackPanel Margin="0,12,0,0">
                <TextBlock Text="Input uses key presses and timed ramps." Style="{StaticResource Caption}" Margin="0,0,0,14" />
                <TextBlock Text="Input source" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,7" />
                <ComboBox ItemsSource="{Binding SelectedKeyboard.Sources}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                          ItemContainerStyle="{StaticResource ConnectedChoice}"
                          DisplayMemberPath="SourceLabel" AutomationProperties.Name="Input source" />
                <TextBlock Text="{Binding SelectedSource.DevicePath}" Style="{StaticResource Caption}" FontSize="11" Margin="0,10,0,0" />
                <Button Content="Refresh keyboards" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" />
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
