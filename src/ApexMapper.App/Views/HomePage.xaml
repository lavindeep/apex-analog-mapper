<UserControl x:Class="ApexMapper.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ApexMapper.App.ViewModels"
             xmlns:views="clr-namespace:ApexMapper.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}">
  <StackPanel>
    <views:StatusCard DataContext="{Binding Status}" />

    <!-- A newer version, offered where it is seen. One press downloads it, the next restarts into it. -->
    <ui:CardControl Margin="0,12,0,0" Icon="{ui:SymbolIcon ArrowSync24}" DataContext="{Binding Setup.Updates}"
                    Visibility="{Binding Notice, Converter={StaticResource ShowWhenPresent}}">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Updates" />
          <ui:TextBlock Style="{StaticResource RowDescription}" Text="{Binding Notice}" views:Live.Text="{Binding NoticeSpoken}" />
        </StackPanel>
      </ui:CardControl.Header>
      <!-- A download for the steps that install; the row's own arrows for a check. -->
      <ui:Button Content="{Binding ActText}" Command="{Binding Act}"
                 Visibility="{Binding ActText, Converter={StaticResource ShowWhenPresent}}">
        <ui:Button.Style>
          <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Icon" Value="{ui:SymbolIcon ArrowDownload24}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding ActText}" Value="Check for updates">
                <Setter Property="Icon" Value="{ui:SymbolIcon ArrowSync24}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ui:Button.Style>
      </ui:Button>
    </ui:CardControl>

    <ui:TextBlock Style="{StaticResource SectionTitle}" Text="Your setup" />

    <ui:CardAction Icon="{ui:SymbolIcon Keyboard24}" Command="{Binding OpenKeyboard}" AutomationProperties.Name="Keyboard"
                   AutomationProperties.HelpText="{Binding Keyboard.Description}">
      <StackPanel>
        <ui:TextBlock Text="Keyboard" />
        <ui:TextBlock Style="{StaticResource RowDescription}" Text="{Binding Keyboard.Description}" />
      </StackPanel>
    </ui:CardAction>

    <ui:CardControl Margin="0,4,0,0" Icon="{ui:SymbolIcon Games24}">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Game" />
          <ui:TextBlock Style="{StaticResource RowDescription}" Text="{Binding Game.RowText}" />
        </StackPanel>
      </ui:CardControl.Header>
      <StackPanel Orientation="Horizontal" DataContext="{Binding Game}">
        <Grid>
        <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding Selected}" IsEnabled="{Binding CanChoose}" Width="260"
                  IsDropDownOpen="{Binding IsListOpen, Mode=OneWayToSource}" AutomationProperties.Name="Game">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="vm:GameItem">
              <StackPanel>
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                <ui:TextBlock Style="{StaticResource CardSummary}" Text="{Binding Detail}" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ui:TextBlock Margin="12,0,36,0" VerticalAlignment="Center" IsHitTestVisible="False" Text="Choose a game window"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Visibility="{Binding Selected, Converter={StaticResource ShowWhenAbsent}}" />
        </Grid>
        <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Look for games again" Command="{Binding Refresh}"
                   AutomationProperties.Name="Look for games again" />
      </StackPanel>
    </ui:CardControl>
    <StackPanel DataContext="{Binding Game}">
      <ui:InfoBar Style="{StaticResource Warning}" Margin="0,4,0,4" Severity="Informational" Message="{Binding Hint}" views:Live.Text="{Binding Hint}"
                  Visibility="{Binding Hint, Converter={StaticResource ShowWhenPresent}}" />
      <ui:InfoBar Style="{StaticResource Warning}" Margin="0,4,0,4" Message="{Binding Warning}" views:Live.Text="{Binding Warning}"
                  Visibility="{Binding Warning, Converter={StaticResource ShowWhenPresent}}" />
    </StackPanel>

    <ui:CardControl Margin="0,4,0,0" Icon="{ui:SymbolIcon Options24}">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Profile" />
          <ui:TextBlock Style="{StaticResource RowDescription}" Text="Which keys press which controller inputs"
                        Visibility="{Binding Profile.SwitchHint, Converter={StaticResource ShowWhenAbsent}}" />
          <!-- Why the list is off: mapping is running, or there are changes to save. -->
          <ui:TextBlock Style="{StaticResource RowDescription}" Text="{Binding Profile.SwitchHint}"
                        Visibility="{Binding Profile.SwitchHint, Converter={StaticResource ShowWhenPresent}}" />
        </StackPanel>
      </ui:CardControl.Header>
      <StackPanel Orientation="Horizontal">
        <ComboBox ItemsSource="{Binding Profile.Profiles}" SelectedItem="{Binding Profile.Selected}" DisplayMemberPath="Name"
                  IsEnabled="{Binding Profile.CanSwitch}" Width="212" AutomationProperties.Name="Profile" />
        <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon Edit24}" Content="Edit profiles" Command="{Binding OpenProfile}" />
      </StackPanel>
    </ui:CardControl>

    <ui:CardAction Margin="0,4,0,0" Icon="{ui:SymbolIcon Gauge24}" Command="{Binding OpenCalibration}" AutomationProperties.Name="Calibration"
                   AutomationProperties.HelpText="{Binding Calibration.Summary}">
      <StackPanel>
        <ui:TextBlock Text="Calibration" />
        <ui:TextBlock Style="{StaticResource RowDescription}" Text="{Binding Calibration.Summary}" />
      </StackPanel>
    </ui:CardAction>

    <ui:CardAction Margin="0,24,0,0" Icon="{ui:SymbolIcon Settings24}" Command="{Binding OpenSettings}" AutomationProperties.Name="Settings"
                   AutomationProperties.HelpText="{Binding Setup.Summary}">
      <StackPanel>
        <ui:TextBlock Text="Settings" />
        <ui:TextBlock Style="{StaticResource RowDescription}" Text="{Binding Setup.Summary}" />
      </StackPanel>
    </ui:CardAction>
  </StackPanel>
</UserControl>
