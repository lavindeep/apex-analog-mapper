<UserControl x:Class="ApexMapper.App.Views.SetupCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ApexMapper.App.ViewModels"
             xmlns:views="clr-namespace:ApexMapper.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SetupViewModel}">
  <ui:CardExpander Icon="{ui:SymbolIcon Wrench24}" IsExpanded="{Binding IsOpen}" AutomationProperties.Name="Setup">
    <ui:CardExpander.Header>
      <StackPanel>
        <ui:TextBlock FontTypography="BodyStrong" Text="Setup" />
        <ui:TextBlock Style="{StaticResource CardSummary}" Text="{Binding Summary}" />
      </StackPanel>
    </ui:CardExpander.Header>
    <StackPanel>
      <ui:TextBlock FontTypography="BodyStrong" Text="Controller driver" Margin="0,0,0,4" />
      <ui:TextBlock Style="{StaticResource Paragraph}" Text="{Binding DriverText}" />
      <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Open24}" Content="Open the ViGEmBus release page" Command="{Binding OpenDriverPage}"
                 Visibility="{Binding DriverMissing, Converter={StaticResource ShowWhenTrue}}" />

      <ui:TextBlock FontTypography="BodyStrong" Text="Steam" Margin="0,8,0,4" />
      <ui:TextBlock Style="{StaticResource Paragraph}"
                    Text="If the game runs through Steam, turn off Steam Input for it in the game's controller settings. Otherwise Steam treats the virtual controller as one of its own and may remap or hide it." />

      <ui:TextBlock FontTypography="BodyStrong" Text="Before you play" Margin="0,8,0,4" />
      <ui:TextBlock Style="{StaticResource Paragraph}"
                    Text="Start works before or after the game launches, but some games only look for controllers when they start, and the virtual controller appears when mapping starts. Pressing Start first is safest: mapping waits for the game." />

      <ui:TextBlock FontTypography="BodyStrong" Text="Files" Margin="0,8,0,4" />
      <ui:TextBlock Style="{StaticResource Paragraph}" Text="Profiles, calibration, settings and the log are kept in one folder." />
      <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" Content="Open the data folder" Command="{Binding OpenDataFolder}" />

      <StackPanel DataContext="{Binding Updates}">
        <ui:TextBlock FontTypography="BodyStrong" Text="Updates" Margin="0,16,0,4" />
        <ui:TextBlock Style="{StaticResource Paragraph}" Text="{Binding VersionText}" />
        <ui:TextBlock Style="{StaticResource Paragraph}" Text="{Binding Text}" views:Live.Text="{Binding Spoken}"
                      Visibility="{Binding Text, Converter={StaticResource ShowWhenPresent}}" />
        <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Content="{Binding ActText}" Command="{Binding Act}"
                   Visibility="{Binding ActText, Converter={StaticResource ShowWhenPresent}}" />
        <ui:ToggleSwitch Margin="0,12,0,0" Content="Look for updates when the app starts" IsChecked="{Binding CheckOnLaunch}"
                         ToolTip="The app asks GitHub when it starts, unless it had an answer in the last six hours."
                         Visibility="{Binding Installed, Converter={StaticResource ShowWhenTrue}}" />
        <ui:ToggleSwitch Margin="0,8,0,0" Content="Offer test versions too" IsChecked="{Binding Prereleases}"
                         ToolTip="Test versions come out before a release, to try changes early. They may have bugs a release would not."
                         Visibility="{Binding CanChoosePrereleases, Converter={StaticResource ShowWhenTrue}}" />
      </StackPanel>
    </StackPanel>
  </ui:CardExpander>
</UserControl>
