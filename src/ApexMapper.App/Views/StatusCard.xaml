<UserControl x:Class="ApexMapper.App.Views.StatusCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ApexMapper.App.ViewModels"
             xmlns:views="clr-namespace:ApexMapper.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:StatusViewModel}">
  <ui:Card Padding="24,20">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- The state at a glance: its icon and colour. -->
        <ui:SymbolIcon Margin="0,2,16,0" VerticalAlignment="Top" FontSize="32" Filled="True">
          <ui:SymbolIcon.Style>
            <Style TargetType="ui:SymbolIcon">
              <Setter Property="Symbol" Value="CheckmarkCircle24" />
              <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StatusTone.NotReady}">
                  <Setter Property="Symbol" Value="Warning24" />
                  <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StatusTone.Busy}">
                  <Setter Property="Symbol" Value="ArrowSync24" />
                  <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StatusTone.Mapping}">
                  <Setter Property="Symbol" Value="PlayCircle24" />
                  <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StatusTone.Paused}">
                  <Setter Property="Symbol" Value="PauseCircle24" />
                  <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ui:SymbolIcon.Style>
        </ui:SymbolIcon>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <ui:TextBlock FontTypography="Subtitle" FontFamily="{StaticResource DisplayFont}" TextWrapping="Wrap" Text="{Binding StateText}" views:Live.Text="{Binding StateText}" />
          <ui:TextBlock Margin="0,4,0,0" Style="{StaticResource Paragraph}" Text="{Binding Reason}" views:Live.Text="{Binding Reason}"
                        Visibility="{Binding Reason, Converter={StaticResource ShowWhenPresent}}" />
          <!-- Why Start is unavailable, and the way to fix it when there is one. -->
          <ui:TextBlock Margin="0,4,0,0" Style="{StaticResource Paragraph}" Text="{Binding Blocker}" views:Live.Text="{Binding Blocker}"
                        Visibility="{Binding Blocker, Converter={StaticResource ShowWhenPresent}}" />
          <WrapPanel Margin="0,4,0,0">
            <ui:Button Margin="0,8,8,0" Appearance="Primary" Icon="{ui:SymbolIcon Keyboard24}" Content="Open the keyboard page" Command="{Binding GoToKeyboard}"
                       Visibility="{Binding BlockedByKeyboard, Converter={StaticResource ShowWhenTrue}}" />
            <ui:Button Margin="0,8,8,0" Appearance="Primary" Icon="{ui:SymbolIcon Gauge24}" Content="Calibrate" Command="{Binding GoToCalibration}"
                       Visibility="{Binding BlockedByCalibration, Converter={StaticResource ShowWhenTrue}}" />
            <ui:Button Margin="0,8,8,0" Appearance="Primary" Icon="{ui:SymbolIcon Open24}" Content="Open ViGEmBus releases" Command="{Binding OpenDriverPage}"
                       Visibility="{Binding BlockedByDriver, Converter={StaticResource ShowWhenTrue}}" />
            <ui:Button Margin="0,8,8,0" Appearance="Primary" Icon="{ui:SymbolIcon ArrowClockwise24}" Content="Restart the app" Command="{Binding Restart}"
                       Visibility="{Binding RestartRequired, Converter={StaticResource ShowWhenTrue}}" />
          </WrapPanel>
        </StackPanel>

        <!-- One button, Start while stopped and Stop while a session is up, so pressing it keeps focus on it. -->
        <ui:Button Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Top" Appearance="Primary" MinWidth="120" Padding="16,10"
                   AutomationProperties.HelpText="{Binding Blocker, TargetNullValue=''}" ToolTip="{Binding Blocker}" ToolTipService.ShowOnDisabled="True">
          <ui:Button.Style>
            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
              <Setter Property="Content" Value="Start" />
              <Setter Property="Icon" Value="{ui:SymbolIcon Play24}" />
              <Setter Property="Command" Value="{Binding Start}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding CanStop}" Value="True">
                  <Setter Property="Content" Value="Stop" />
                  <Setter Property="Icon" Value="{ui:SymbolIcon Stop24}" />
                  <Setter Property="Command" Value="{Binding Stop}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ui:Button.Style>
        </ui:Button>
      </Grid>

      <StackPanel Margin="48,12,0,0" Visibility="{Binding Blocker, Converter={StaticResource ShowWhenAbsent}}">
        <ui:TextBlock Style="{StaticResource RowDescription}" Text="Ctrl+Left Alt+F12 stops mapping from anywhere, even while the game is in front." />
        <ui:TextBlock Margin="0,4,0,0" Style="{StaticResource RowDescription}" Text="{Binding Timing}"
                      Visibility="{Binding Timing, Converter={StaticResource ShowWhenPresent}}" />
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Warnings}" AutomationProperties.Name="Warnings">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:InfoBar Style="{StaticResource Warning}" Message="{Binding}" views:Live.Text="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ui:Card>
</UserControl>
