<UserControl x:Class="ApexMapper.App.Views.StatusCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ApexMapper.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:StatusViewModel}">
  <ui:Card Padding="20,16">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <ui:TextBlock FontTypography="Subtitle" Text="{Binding StateText}" />
          <ui:TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Reason}"
                        Visibility="{Binding Reason, Converter={StaticResource ShowWhenPresent}}" />
        </StackPanel>
        <!-- Whichever of Start and Stop can be pressed is the prominent one. -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <ui:Button Icon="{ui:SymbolIcon Play24}" Content="Start" MinWidth="96" Command="{Binding Start}"
                     AutomationProperties.HelpText="{Binding Blocker, TargetNullValue=''}" ToolTip="{Binding Blocker}" ToolTipService.ShowOnDisabled="True">
            <ui:Button.Style>
              <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Primary" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CanStop}" Value="True">
                    <Setter Property="Appearance" Value="Secondary" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ui:Button.Style>
          </ui:Button>
          <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon Stop24}" Content="Stop" MinWidth="96" Command="{Binding Stop}">
            <ui:Button.Style>
              <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Secondary" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CanStop}" Value="True">
                    <Setter Property="Appearance" Value="Primary" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ui:Button.Style>
          </ui:Button>
        </StackPanel>
      </Grid>

      <ui:TextBlock Margin="0,8,0,0" Style="{StaticResource CardSummary}" Text="Ctrl+Left Alt+F12 stops mapping from anywhere, even while the game is in front." />

      <!-- Why Start is unavailable. -->
      <Grid Margin="0,12,0,0" Visibility="{Binding Blocker, Converter={StaticResource ShowWhenPresent}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:SymbolIcon Symbol="Info24" Margin="0,0,8,0" VerticalAlignment="Center" />
        <ui:TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Blocker}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <ui:Button Margin="8,0,0,0" Content="Go to calibration" Command="{Binding GoToCalibration}"
                     Visibility="{Binding BlockedByCalibration, Converter={StaticResource ShowWhenTrue}}" />
          <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon Open24}" Content="Open the ViGEmBus release page" Command="{Binding OpenDriverPage}"
                     Visibility="{Binding BlockedByDriver, Converter={StaticResource ShowWhenTrue}}" />
          <ui:Button Margin="8,0,0,0" Appearance="Primary" Icon="{ui:SymbolIcon ArrowClockwise24}" Content="Restart the app" Command="{Binding Restart}"
                     Visibility="{Binding RestartRequired, Converter={StaticResource ShowWhenTrue}}" />
        </StackPanel>
      </Grid>

      <ui:TextBlock Margin="0,8,0,0" Style="{StaticResource CardSummary}" Text="{Binding Timing}"
                    Visibility="{Binding Timing, Converter={StaticResource ShowWhenPresent}}" />

      <ItemsControl ItemsSource="{Binding Warnings}" AutomationProperties.Name="Warnings">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:InfoBar Style="{StaticResource Warning}" Message="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ui:Card>
</UserControl>
