<UserControl x:Class="ApexMapper.App.Views.StatusCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ApexMapper.App.ViewModels"
             xmlns:views="clr-namespace:ApexMapper.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:StatusViewModel}">
  <UserControl.Resources>
    <Style x:Key="Banners" TargetType="ItemsControl">
      <Style.Triggers>
        <Trigger Property="HasItems" Value="True">
          <Setter Property="Margin" Value="0,8,0,0" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <!-- The same side padding and icon column as the rows below, so the card's words start on the rows' line. -->
  <ui:Card Padding="16,20">
    <StackPanel>
      <!-- The state and Start or Stop on the first line, and what to do under both, so the words get the card's width. -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The state at a glance: its icon and colour. -->
        <ui:SymbolIcon Margin="0,0,8,0" VerticalAlignment="Center" FontSize="28" Filled="True">
          <ui:SymbolIcon.Style>
            <Style TargetType="ui:SymbolIcon">
              <Setter Property="Symbol" Value="CheckmarkCircle24" />
              <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StatusTone.NotReady}">
                  <Setter Property="Symbol" Value="Warning24" />
                  <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StatusTone.Busy}">
                  <Setter Property="Symbol" Value="ArrowSync24" />
                  <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StatusTone.Mapping}">
                  <Setter Property="Symbol" Value="PlayCircle24" />
                  <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StatusTone.Paused}">
                  <Setter Property="Symbol" Value="PauseCircle24" />
                  <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ui:SymbolIcon.Style>
        </ui:SymbolIcon>

        <ui:TextBlock Grid.Column="1" VerticalAlignment="Center" FontTypography="Subtitle" FontFamily="{StaticResource DisplayFont}" TextWrapping="Wrap"
                      Text="{Binding StateText}" views:Live.Text="{Binding StateText}" />
        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
          <ui:TextBlock Margin="0,4,0,0" Style="{StaticResource Paragraph}" Text="{Binding Reason}" views:Live.Text="{Binding Reason}"
                        Visibility="{Binding Reason, Converter={StaticResource ShowWhenPresent}}" />
          <!-- Why Start is unavailable, and the way to fix it when there is one. -->
          <ui:TextBlock Margin="0,4,0,0" Style="{StaticResource Paragraph}" Text="{Binding Blocker}" views:Live.Text="{Binding Blocker}"
                        Visibility="{Binding Blocker, Converter={StaticResource ShowWhenPresent}}" />
          <WrapPanel>
            <ui:Button Margin="0,12,8,0" Appearance="Primary" Icon="{ui:SymbolIcon Keyboard24}" Content="Open the Keyboard page" Command="{Binding GoToKeyboard}"
                       Visibility="{Binding BlockedByKeyboard, Converter={StaticResource ShowWhenTrue}}" />
            <ui:Button Margin="0,12,8,0" Appearance="Primary" Icon="{ui:SymbolIcon Gauge24}" Content="Calibrate" Command="{Binding GoToCalibration}"
                       Visibility="{Binding BlockedByCalibration, Converter={StaticResource ShowWhenTrue}}" />
            <ui:Button Margin="0,12,8,0" Appearance="Primary" Icon="{ui:SymbolIcon Open24}" Content="Open ViGEmBus releases" Command="{Binding OpenDriverPage}"
                       Visibility="{Binding BlockedByDriver, Converter={StaticResource ShowWhenTrue}}" />
            <ui:Button Margin="0,12,8,0" Appearance="Primary" Icon="{ui:SymbolIcon ArrowClockwise24}" Content="Restart the app" Command="{Binding Restart}"
                       Visibility="{Binding RestartRequired, Converter={StaticResource ShowWhenTrue}}" />
          </WrapPanel>
        </StackPanel>

        <!-- One button, Start while stopped and Stop while a session is up, so pressing it keeps focus on it. -->
        <ui:Button Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Appearance="Primary" MinWidth="120" Padding="16,10"
                   AutomationProperties.HelpText="{Binding Blocker, TargetNullValue=''}" ToolTip="{Binding Blocker}" ToolTipService.ShowOnDisabled="True">
          <ui:Button.Style>
            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
              <Setter Property="Content" Value="Start" />
              <Setter Property="Icon" Value="{ui:SymbolIcon Play24}" />
              <Setter Property="Command" Value="{Binding Start}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding CanStop}" Value="True">
                  <Setter Property="Content" Value="Stop" />
                  <Setter Property="Icon" Value="{ui:SymbolIcon Stop24}" />
                  <Setter Property="Command" Value="{Binding Stop}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ui:Button.Style>
        </ui:Button>

        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Visibility="{Binding Blocker, Converter={StaticResource ShowWhenAbsent}}">
          <!-- The stop shortcut drawn as its keys, joined by plus signs since they are held together. -->
          <WrapPanel>
            <Border Style="{StaticResource Keycap}"><ui:TextBlock Style="{StaticResource KeycapText}" FontTypography="Caption" Text="Ctrl" /></Border>
            <ui:TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Style="{StaticResource RowDescription}" Text="+" />
            <Border Style="{StaticResource Keycap}"><ui:TextBlock Style="{StaticResource KeycapText}" FontTypography="Caption" Text="Left Alt" /></Border>
            <ui:TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Style="{StaticResource RowDescription}" Text="+" />
            <Border Style="{StaticResource Keycap}"><ui:TextBlock Style="{StaticResource KeycapText}" FontTypography="Caption" Text="F12" /></Border>
            <ui:TextBlock VerticalAlignment="Center" Style="{StaticResource RowDescription}" Text="stops mapping from anywhere, even in the game." />
          </WrapPanel>
          <ui:TextBlock Margin="0,4,0,0" Style="{StaticResource RowDescription}" Text="{Binding Timing}"
                        Visibility="{Binding Timing, Converter={StaticResource ShowWhenPresent}}" />
        </StackPanel>
      </Grid>

      <!-- Room above a list of banners only while it has one, so an empty list adds no space. -->
      <ItemsControl ItemsSource="{Binding Warnings}" AutomationProperties.Name="Warnings" Style="{StaticResource Banners}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:InfoBar Style="{StaticResource Warning}" Message="{Binding}" views:Live.Text="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <!-- What the app handled itself, quieter than a warning since nothing needs doing. -->
      <ItemsControl ItemsSource="{Binding Notes}" AutomationProperties.Name="Notes" Style="{StaticResource Banners}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:InfoBar Style="{StaticResource Warning}" Severity="Informational" Message="{Binding}" views:Live.Text="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ui:Card>
</UserControl>
