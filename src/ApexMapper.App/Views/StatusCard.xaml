<UserControl x:Class="ApexMapper.App.Views.StatusCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ApexMapper.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:StatusViewModel}">
  <ui:Card Padding="20,16">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <ui:TextBlock FontTypography="Subtitle" Text="{Binding StateText}" />
          <ui:TextBlock Margin="0,2,0,0" Style="{StaticResource CardSummary}" TextWrapping="Wrap" TextTrimming="None"
                        Text="{Binding Reason}" Visibility="{Binding Reason, Converter={StaticResource ShowWhenPresent}}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Content="Start" MinWidth="96" Command="{Binding Start}" />
          <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon Stop24}" Content="Stop" MinWidth="96" Command="{Binding Stop}" />
        </StackPanel>
      </Grid>

      <ui:TextBlock Margin="0,8,0,0" Style="{StaticResource CardSummary}" Text="Ctrl+Alt+F12 stops mapping from anywhere, even while the game is in front." />

      <!-- Why Start is unavailable. -->
      <Grid Margin="0,12,0,0" Visibility="{Binding Blocker, Converter={StaticResource ShowWhenPresent}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:SymbolIcon Symbol="Info24" Margin="0,0,8,0" VerticalAlignment="Center" />
        <ui:TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Blocker}" />
        <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="Go to calibration" Command="{Binding GoToCalibration}"
                   Visibility="{Binding BlockedByCalibration, Converter={StaticResource ShowWhenTrue}}" />
      </Grid>

      <ui:TextBlock Margin="0,8,0,0" Style="{StaticResource CardSummary}" Text="{Binding Timing}"
                    Visibility="{Binding Timing, Converter={StaticResource ShowWhenPresent}}" />

      <ItemsControl ItemsSource="{Binding Warnings}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:InfoBar Style="{StaticResource Warning}" Message="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ui:Button Margin="0,8,0,0" Appearance="Caution" Icon="{ui:SymbolIcon ArrowClockwise24}" Content="Restart the app" Command="{Binding Restart}"
                 Visibility="{Binding RestartRequired, Converter={StaticResource ShowWhenTrue}}" />
    </StackPanel>
  </ui:Card>
</UserControl>
