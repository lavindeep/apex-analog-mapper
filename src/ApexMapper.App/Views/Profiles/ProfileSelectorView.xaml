<UserControl
    x:Class="ApexMapper.App.Views.Profiles.ProfileSelectorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:ApexMapper.App.ViewModels.Profiles"
    x:Name="Root">

    <UserControl.Resources>
        <!-- Row highlight for the currently resolved profile -->
        <Style x:Key="ProfileRowStyle" TargetType="ListBoxItem">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsResolved}" Value="True">
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Profile list -->
        <ListBox
            Grid.Row="0"
            ItemsSource="{Binding Profiles}"
            SelectedItem="{Binding Selected, Mode=TwoWay}"
            ItemContainerStyle="{StaticResource ProfileRowStyle}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ProfileListItem}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="{Binding DisplayName}"
                            VerticalAlignment="Center" />

                        <!-- Pin / Unpin toggle button bound back to root VM via ElementName -->
                        <Button
                            Grid.Column="1"
                            Margin="4,0,0,0"
                            Padding="4,2">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Content" Value="Pin" />
                                    <Setter Property="Command"
                                            Value="{Binding DataContext.PinCommand, ElementName=Root}" />
                                    <Setter Property="CommandParameter" Value="{Binding Id}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter Property="Content" Value="Unpin" />
                                            <Setter Property="Command"
                                                    Value="{Binding DataContext.UnpinCommand, ElementName=Root}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
            <Button
                Content="Refresh"
                Command="{Binding RefreshCommand}"
                Padding="8,3" />
            <TextBlock
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Text="{Binding ResolvedProfileName, StringFormat='Auto: {0}'}" />
        </StackPanel>
    </Grid>
</UserControl>
