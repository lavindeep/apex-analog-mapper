<UserControl
    x:Class="ApexMapper.App.Views.Calibration.CalibrationWizardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="clr-namespace:ApexMapper.App.Views.Calibration"
    x:Name="Root">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock
            Grid.Row="0"
            Text="Calibration Wizard"
            FontSize="16"
            FontWeight="Bold"
            Margin="0,0,0,8" />

        <!-- Step content area: swap based on Current step -->
        <ContentControl Grid.Row="1" Content="{Binding}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Style.Triggers>

                        <DataTrigger Binding="{Binding Current}" Value="Rest">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <cal:CalibrationStepRest />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Current}" Value="Max">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <cal:CalibrationStepMax />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Current}" Value="Noise">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <cal:CalibrationStepNoise />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>

                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <!-- Global status / progress (visible in Idle / ConfirmSave / Saved / Cancelled) -->
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <ProgressBar
                Height="10"
                Minimum="0" Maximum="1"
                Value="{Binding Progress, Mode=OneWay}" />
            <TextBlock
                Text="{Binding StatusMessage}"
                TextWrapping="Wrap"
                Foreground="DimGray"
                FontSize="11"
                Margin="0,4,0,0" />
        </StackPanel>

        <!-- Button bar -->
        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,8,0,0">

            <!-- Start (Idle only) -->
            <Button
                Content="Start"
                Padding="16,4"
                Margin="0,0,8,0"
                Command="{Binding StartCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Current}" Value="Idle">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Next (Rest / Max / Noise / ConfirmSave) -->
            <Button
                Content="Next"
                Padding="16,4"
                Margin="0,0,8,0"
                Command="{Binding NextCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Current}" Value="Rest">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Current}" Value="Max">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Current}" Value="Noise">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Current}" Value="ConfirmSave">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Cancel -->
            <Button
                Content="Cancel"
                Padding="16,4"
                Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
