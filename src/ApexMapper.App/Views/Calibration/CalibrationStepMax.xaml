<UserControl
    x:Class="ApexMapper.App.Views.Calibration.CalibrationStepMax"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="8">
        <TextBlock FontWeight="Bold" Text="Step 2: Maximum Press" />
        <TextBlock TextWrapping="Wrap">
            Press all keys fully to their maximum actuation depth. Hold them down
            until the sampling window completes.
        </TextBlock>
        <ProgressBar
            Height="12"
            Minimum="0" Maximum="1"
            Value="{Binding Progress, Mode=OneWay}" />
        <TextBlock
            Text="{Binding StatusMessage}"
            TextWrapping="Wrap"
            Foreground="DimGray"
            FontSize="11" />
    </StackPanel>
</UserControl>
