<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:views="clr-namespace:ApexMapper.App.Views">
  <!-- The cards' converters and styles, on top of the WPF-UI theme and controls. -->
  <ResourceDictionary.MergedDictionaries>
    <ui:ThemesDictionary Theme="Dark" />
    <ui:ControlsDictionary />
  </ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="ShowWhenTrue" />
  <views:PresenceToVisibility x:Key="ShowWhenPresent" />
  <views:PresenceToVisibility x:Key="ShowWhenAbsent" Invert="True" />
  <views:FractionOfLength x:Key="FractionOfLength" />
  <views:ExponentToPosition x:Key="ExponentToPosition" />
  <views:PageToVisibility x:Key="ShowOnPage" />
  <views:PageToVisibility x:Key="HideOnPage" Invert="True" />

  <!-- A card's second header line: what is chosen, or what is missing. -->
  <Style x:Key="CardSummary" TargetType="ui:TextBlock">
    <Setter Property="FontTypography" Value="Caption" />
    <Setter Property="Appearance" Value="Secondary" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Style.Triggers>
      <!-- Inside a disabled picker, so the line under the name never stands out more than the name. -->
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Appearance" Value="Disabled" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- A row's second line on Home, which wraps rather than cut off beside the row's controls. -->
  <Style x:Key="RowDescription" TargetType="ui:TextBlock" BasedOn="{StaticResource CardSummary}">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextTrimming" Value="None" />
  </Style>

  <!-- Body text that wraps, with room below it. -->
  <Style x:Key="Paragraph" TargetType="ui:TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style x:Key="Note" TargetType="ui:TextBlock" BasedOn="{StaticResource Paragraph}">
    <Setter Property="Appearance" Value="Secondary" />
  </Style>

  <!-- A heading over a group of cards. -->
  <Style x:Key="SectionTitle" TargetType="ui:TextBlock">
    <Setter Property="FontTypography" Value="BodyStrong" />
    <Setter Property="Margin" Value="4,28,0,8" />
  </Style>

  <!-- A label above a control in the editors. -->
  <Style x:Key="FieldLabel" TargetType="ui:TextBlock">
    <Setter Property="FontTypography" Value="BodyStrong" />
    <Setter Property="Margin" Value="0,12,0,4" />
  </Style>

  <!-- A key as it looks on the keyboard. -->
  <Style x:Key="Keycap" TargetType="Border">
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="KeycapText" TargetType="ui:TextBlock">
    <Setter Property="FontTypography" Value="BodyStrong" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- A numbered step's marker, and its title. -->
  <Style x:Key="StepNumber" TargetType="Border">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style x:Key="StepNumberText" TargetType="ui:TextBlock">
    <Setter Property="FontTypography" Value="BodyStrong" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="StepTitle" TargetType="ui:TextBlock">
    <Setter Property="FontTypography" Value="BodyStrong" />
    <Setter Property="Margin" Value="0,4,0,8" />
  </Style>

  <!-- A warning that stays until its cause goes: no close button. -->
  <Style x:Key="Warning" TargetType="ui:InfoBar" BasedOn="{StaticResource {x:Type ui:InfoBar}}">
    <Setter Property="Severity" Value="Warning" />
    <Setter Property="IsOpen" Value="True" />
    <Setter Property="IsClosable" Value="False" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>
</ResourceDictionary>
