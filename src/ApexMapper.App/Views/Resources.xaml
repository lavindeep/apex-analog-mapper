<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:views="clr-namespace:ApexMapper.App.Views">
  <!-- The cards' converters and styles, on top of the WPF-UI theme and controls. -->
  <ResourceDictionary.MergedDictionaries>
    <ui:ThemesDictionary Theme="Dark" />
    <ui:ControlsDictionary />
  </ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="ShowWhenTrue" />
  <views:PresenceToVisibility x:Key="ShowWhenPresent" />
  <views:PresenceToVisibility x:Key="ShowWhenAbsent" Invert="True" />
  <views:FractionOfLength x:Key="FractionOfLength" />

  <!-- A card's second header line: what is chosen, or what is missing. -->
  <Style x:Key="CardSummary" TargetType="ui:TextBlock">
    <Setter Property="FontTypography" Value="Caption" />
    <Setter Property="Appearance" Value="Secondary" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- Body text that wraps, with room below it. -->
  <Style x:Key="Paragraph" TargetType="ui:TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style x:Key="Note" TargetType="ui:TextBlock" BasedOn="{StaticResource Paragraph}">
    <Setter Property="Appearance" Value="Secondary" />
  </Style>

  <!-- A label above a control in the editors. -->
  <Style x:Key="FieldLabel" TargetType="ui:TextBlock">
    <Setter Property="FontTypography" Value="BodyStrong" />
    <Setter Property="Margin" Value="0,12,0,4" />
  </Style>

  <!-- A warning that stays until its cause goes: no close button. -->
  <Style x:Key="Warning" TargetType="ui:InfoBar" BasedOn="{StaticResource {x:Type ui:InfoBar}}">
    <Setter Property="Severity" Value="Warning" />
    <Setter Property="IsOpen" Value="True" />
    <Setter Property="IsClosable" Value="False" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>
</ResourceDictionary>
