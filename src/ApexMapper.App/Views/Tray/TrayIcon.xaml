<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    xmlns:tray="clr-namespace:ApexMapper.App.ViewModels.Tray">

    <tb:TaskbarIcon
        x:Key="ApexMapperTrayIcon"
        ToolTipText="Apex Analog Mapper"
        IconSource="/Resources/TrayIcon.ico">

        <tb:TaskbarIcon.ContextMenu>
            <ContextMenu>
                <MenuItem>
                    <MenuItem.Style>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="Start" />
                            <Setter Property="Command" Value="{Binding ToggleEnabledCommand}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                    <Setter Property="Header" Value="Stop" />
                                    <Setter Property="Command" Value="{Binding PanicCommand}" />
                                    <Setter Property="InputGestureText" Value="Ctrl+Alt+F12" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
                <Separator />
                <!--
                    Switch Profile submenu: ItemsSource is bound to the VM's Profiles list.
                    Each child MenuItem's DataContext is a TrayProfileEntry, so we use
                    ItemContainerStyle + RelativeSource FindAncestor to reach the ContextMenu's
                    DataContext (the VM) and bind SwitchProfileCommand from there.
                -->
                <MenuItem
                    Header="{Binding CurrentProfileName}"
                    HeaderStringFormat="Profile: {0}"
                    ItemsSource="{Binding Profiles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding DisplayName}" />
                            <Setter Property="Command"
                                    Value="{Binding DataContext.SwitchProfileCommand,
                                            RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                            <Setter Property="CommandParameter" Value="{Binding ProfileId}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="Open Apex Analog Mapper" Command="{Binding OpenMainWindowCommand}" />
                <Separator />
                <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
            </ContextMenu>
        </tb:TaskbarIcon.ContextMenu>

    </tb:TaskbarIcon>

</ResourceDictionary>
