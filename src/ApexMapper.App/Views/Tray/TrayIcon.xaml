<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    xmlns:tray="clr-namespace:ApexMapper.App.ViewModels.Tray">

    <tb:TaskbarIcon
        x:Key="ApexMapperTrayIcon"
        ToolTipText="Apex Analog Mapper"
        IconSource="/Resources/TrayIcon.ico">

        <tb:TaskbarIcon.ContextMenu>
            <ContextMenu>
                <MenuItem
                    Header="Enabled"
                    IsCheckable="True"
                    IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                    Command="{Binding ToggleEnabledCommand}" />
                <Separator />
                <MenuItem
                    Header="{Binding CurrentProfileName, StringFormat='Profile: {0}'}"
                    IsEnabled="False" />
                <Separator />
                <MenuItem Header="Open Apex Mapper" Command="{Binding OpenMainWindowCommand}" />
                <MenuItem Header="Panic (zero output)" Command="{Binding PanicCommand}" />
                <Separator />
                <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
            </ContextMenu>
        </tb:TaskbarIcon.ContextMenu>

    </tb:TaskbarIcon>

</ResourceDictionary>
