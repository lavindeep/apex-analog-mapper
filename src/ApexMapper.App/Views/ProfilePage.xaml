<UserControl x:Class="ApexMapper.App.Views.ProfilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ApexMapper.App.ViewModels"
             xmlns:views="clr-namespace:ApexMapper.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProfileViewModel}"
             x:Name="Root">
  <UserControl.Resources>
    <!-- A 0 to 1 setting with its value beside the slider. -->
    <Style x:Key="FractionSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="1" />
      <Setter Property="TickFrequency" Value="0.01" />
      <Setter Property="IsSnapToTickEnabled" Value="True" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,6" />
    </Style>
    <Style x:Key="SliderValue" TargetType="ui:TextBlock">
      <Setter Property="Width" Value="48" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style x:Key="Milliseconds" TargetType="ui:NumberBox" BasedOn="{StaticResource {x:Type ui:NumberBox}}">
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="5000" />
      <Setter Property="SmallChange" Value="10" />
      <Setter Property="LargeChange" Value="100" />
      <Setter Property="MaxDecimalPlaces" Value="0" />
      <Setter Property="Width" Value="140" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
  </UserControl.Resources>

  <StackPanel>
    <!-- Which profile is active, and the profiles themselves. -->
    <ui:CardControl Icon="{ui:SymbolIcon Options24}">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Profile" />
          <ui:TextBlock Style="{StaticResource RowDescription}" Text="Start on Home uses this profile"
                        Visibility="{Binding SwitchHint, Converter={StaticResource ShowWhenAbsent}}" />
          <ui:TextBlock Style="{StaticResource RowDescription}" Text="{Binding SwitchHint}" views:Live.Text="{Binding SwitchHint}"
                        Visibility="{Binding SwitchHint, Converter={StaticResource ShowWhenPresent}}" />
        </StackPanel>
      </ui:CardControl.Header>
      <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name"
                IsEnabled="{Binding CanSwitch}" Width="240" AutomationProperties.Name="Profile" x:Name="ProfilePicker" />
    </ui:CardControl>
    <ui:InfoBar Style="{StaticResource Warning}" Message="{Binding Problem}" views:Live.Text="{Binding Problem}"
                Visibility="{Binding Problem, Converter={StaticResource ShowWhenPresent}}" />
    <ui:CardControl Margin="0,4,0,0" Icon="{ui:SymbolIcon Rename24}">
      <ui:CardControl.Header>
        <ui:TextBlock x:Name="NameLabel" Text="Name" />
      </ui:CardControl.Header>
      <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="240" IsEnabled="{Binding CanEdit}"
                  AutomationProperties.LabeledBy="{Binding ElementName=NameLabel}" />
    </ui:CardControl>
    <WrapPanel Margin="0,8,0,0">
      <ui:Button Margin="0,0,8,8" Icon="{ui:SymbolIcon Add24}" Content="New profile" Command="{Binding New}"
                 ToolTip="{Binding NewHint}" AutomationProperties.HelpText="{Binding NewHint}" ToolTipService.ShowOnDisabled="True" />
      <ui:Button Margin="0,0,8,8" Icon="{ui:SymbolIcon ArrowReset24}" Content="Reset bindings" Command="{Binding Reset}"
                 ToolTip="{Binding ResetHint}" AutomationProperties.HelpText="{Binding ResetHint}" ToolTipService.ShowOnDisabled="True" />
      <ui:Button Margin="0,0,8,8" Icon="{ui:SymbolIcon Delete24}" Content="Delete profile" Command="{Binding Delete}" IsVisibleChanged="OnDeleteHidden"
                 ToolTip="{Binding DeleteHint}" AutomationProperties.HelpText="{Binding DeleteHint}" ToolTipService.ShowOnDisabled="True"
                 Visibility="{Binding CanDelete, Converter={StaticResource ShowWhenTrue}}" />
    </WrapPanel>

    <!-- The bindings, one open at a time. A binding's settings show only for a Custom preset. -->
    <ui:TextBlock Style="{StaticResource SectionTitle}" Text="Bindings" />
    <ui:TextBlock Margin="0,0,0,12" Style="{StaticResource Note}"
                  Text="Open a binding to change its keys or what they press. Triggers and sticks use the Default preset until you choose Custom." />
    <WrapPanel>
      <ui:Button x:Name="AddKeyButton" Margin="0,0,8,8" Icon="{ui:SymbolIcon Add24}" Content="Add a key" Command="{Binding AddKey}"
                 ToolTip="{Binding AddKeyHint}" AutomationProperties.HelpText="{Binding AddKeyHint}" ToolTipService.ShowOnDisabled="True" />
      <ui:Button x:Name="AddAxisButton" Margin="0,0,8,8" Icon="{ui:SymbolIcon Add24}" Content="Add a stick" Command="{Binding AddAxis}"
                 ToolTip="{Binding AddAxisHint}" AutomationProperties.HelpText="{Binding AddAxisHint}" ToolTipService.ShowOnDisabled="True" />
    </WrapPanel>
    <!-- Waiting for the keys of a new binding. -->
    <StackPanel x:Name="AddPrompt" Margin="0,0,0,12" Visibility="{Binding IsAdding, Converter={StaticResource ShowWhenTrue}}">
      <ui:InfoBar Style="{StaticResource Warning}" Margin="0" Severity="Informational" Message="{Binding Prompt}" views:Live.Text="{Binding Prompt}" />
      <ui:Button Margin="0,8,0,0" Content="Cancel" Command="{Binding CancelCapture}" />
    </StackPanel>
    <ItemsControl x:Name="Bindings" ItemsSource="{Binding Rows}" Focusable="False" Grid.IsSharedSizeScope="True" AutomationProperties.Name="Bindings">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="vm:BindingRowViewModel">
          <ui:CardExpander Margin="0,0,0,4" IsExpanded="{Binding IsExpanded}" AutomationProperties.Name="{Binding Summary}">
            <ui:CardExpander.Header>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" MinWidth="150" SharedSizeGroup="Keys" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                  <Border Style="{StaticResource Keycap}" Visibility="{Binding IsAxis, Converter={StaticResource ShowWhenTrue}}">
                    <ui:TextBlock Style="{StaticResource KeycapText}" Text="{Binding NegativeKeyName}" />
                  </Border>
                  <Border Style="{StaticResource Keycap}">
                    <ui:TextBlock Style="{StaticResource KeycapText}" Text="{Binding KeyName}" />
                  </Border>
                </StackPanel>
                <ui:TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding TargetText}" />
                <ui:TextBlock Grid.Column="2" Margin="12,0,16,0" VerticalAlignment="Center" Style="{StaticResource CardSummary}" Text="{Binding CustomTag}"
                              Visibility="{Binding CustomTag, Converter={StaticResource ShowWhenPresent}}" />
              </Grid>
            </ui:CardExpander.Header>

            <StackPanel>
              <WrapPanel IsEnabled="{Binding DataContext.CanEdit, ElementName=Root}">
                <ui:Button Margin="0,0,8,0" Icon="{ui:SymbolIcon Keyboard24}" Content="{Binding ChangeNegativeKeyText}"
                           ToolTip="{Binding NegativeKeyHint}" AutomationProperties.HelpText="{Binding NegativeKeyHint}" Command="{Binding DataContext.CaptureNegativeKey, ElementName=Root}"
                           Visibility="{Binding IsAxis, Converter={StaticResource ShowWhenTrue}}" />
                <ui:Button Icon="{ui:SymbolIcon Keyboard24}" Content="{Binding ChangeKeyText}" ToolTip="{Binding KeyHint}" AutomationProperties.HelpText="{Binding KeyHint, TargetNullValue=''}"
                           Command="{Binding DataContext.CaptureKey, ElementName=Root}" />
              </WrapPanel>

              <!-- Waiting for a key for this binding. -->
              <StackPanel Margin="0,12,0,0" Visibility="{Binding IsCapturing, Converter={StaticResource ShowWhenTrue}}">
                <ui:InfoBar Style="{StaticResource Warning}" Margin="0" Severity="Informational"
                            Message="{Binding DataContext.Prompt, ElementName=Root}" views:Live.Text="{Binding DataContext.Prompt, ElementName=Root}" />
                <ui:Button Margin="0,8,0,0" Content="Cancel" Command="{Binding DataContext.CancelCapture, ElementName=Root}" />
              </StackPanel>

              <StackPanel IsEnabled="{Binding DataContext.CanEdit, ElementName=Root}">

                <ui:TextBlock Style="{StaticResource FieldLabel}" Text="Controller input" />
                <ComboBox ItemsSource="{Binding Targets}" SelectedValuePath="Value" DisplayMemberPath="Name" SelectedValue="{Binding Target}"
                          Width="260" HorizontalAlignment="Left" AutomationProperties.Name="Controller input" />

                <StackPanel Visibility="{Binding ShapesOutput, Converter={StaticResource ShowWhenTrue}}">
                  <ui:TextBlock Style="{StaticResource FieldLabel}" Text="Preset" />
                  <ComboBox ItemsSource="{x:Static vm:BindingRowViewModel.Presets}" SelectedItem="{Binding Preset}" Width="260" HorizontalAlignment="Left"
                            AutomationProperties.Name="Preset" />
                  <ui:TextBlock Margin="0,8,0,0" Style="{StaticResource Note}" Text="{Binding PresetText}" views:Live.Text="{Binding PresetText}" />

                  <!-- Custom: the curve with the key's place on it, then every setting. -->
                  <StackPanel Grid.IsSharedSizeScope="True" Visibility="{Binding IsCustom, Converter={StaticResource ShowWhenTrue}}">
                    <!-- The graph shares the sliders' label column, so its axis starts where their tracks do. -->
                    <Grid Margin="0,8,0,0" HorizontalAlignment="Left">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Labels" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <ui:TextBlock Margin="0,0,6,0" VerticalAlignment="Top" HorizontalAlignment="Right" Style="{StaticResource CardSummary}" Text="100%" />
                      <ui:TextBlock Margin="0,0,6,0" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource CardSummary}" Text="{Binding OutputName}">
                        <ui:TextBlock.LayoutTransform>
                          <RotateTransform Angle="-90" />
                        </ui:TextBlock.LayoutTransform>
                      </ui:TextBlock>
                      <ui:TextBlock Grid.Row="1" Margin="0,4,6,0" HorizontalAlignment="Right" Style="{StaticResource CardSummary}" Text="0" />
                      <Grid Grid.Row="1" Grid.Column="1" Margin="0,4,0,0">
                        <ui:TextBlock HorizontalAlignment="Center" Style="{StaticResource CardSummary}" Text="How far the key is pressed" />
                        <ui:TextBlock HorizontalAlignment="Right" Style="{StaticResource CardSummary}" Text="100%" />
                      </Grid>
                    <UserControl Grid.Column="1" Focusable="False" AutomationProperties.Name="{Binding GraphName}">
                    <Border BorderThickness="1,0,0,1" Padding="0"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Width="{x:Static vm:ProfileViewModel.PreviewWidth}" Height="{x:Static vm:ProfileViewModel.PreviewHeight}">
                      <Canvas ClipToBounds="False" Visibility="{Binding DeadzoneProblem, Converter={StaticResource ShowWhenAbsent}}">
                        <Polyline Points="{Binding DataContext.Curve, ElementName=Root}" Stroke="{DynamicResource AccentTextFillColorPrimaryBrush}" StrokeThickness="2" />
                        <Ellipse Width="10" Height="10" Margin="-5,-5,0,0" Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                 Canvas.Left="{Binding DataContext.Marker.X, ElementName=Root, FallbackValue=0}"
                                 Canvas.Top="{Binding DataContext.Marker.Y, ElementName=Root, FallbackValue=0}"
                                 Visibility="{Binding DataContext.Marker, ElementName=Root, Converter={StaticResource ShowWhenPresent}}" />
                      </Canvas>
                    </Border>
                    </UserControl>
                    </Grid>
                    <ui:TextBlock Margin="0,8,0,0" Style="{StaticResource Note}" Text="{Binding DataContext.PreviewText, ElementName=Root}"
                                  Visibility="{Binding DataContext.PreviewText, ElementName=Root, Converter={StaticResource ShowWhenPresent}}" />
                    <ui:TextBlock Margin="0,8,0,0" Style="{StaticResource Note}" Text="{Binding DataContext.PreviewNote, ElementName=Root}"
                                  views:Live.Text="{Binding DataContext.PreviewNote, ElementName=Root}"
                                  Visibility="{Binding DataContext.PreviewNote, ElementName=Root, Converter={StaticResource ShowWhenPresent}}" />

                    <Grid Margin="0,4,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Labels" />
                        <ColumnDefinition Width="*" MaxWidth="{x:Static vm:ProfileViewModel.PreviewWidth}" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <ui:TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="0,0,12,0" Text="Curve" />
                      <Slider Grid.Row="0" Grid.Column="1" Style="{StaticResource FractionSlider}" Minimum="-2" Maximum="2" TickFrequency="0.05"
                              Value="{Binding Exponent, Converter={StaticResource ExponentToPosition}}" Margin="0,6,0,0"
                              AutomationProperties.Name="Curve" AutomationProperties.ItemStatus="{Binding CurveText}" AutomationProperties.HelpText="Left is eager, the middle is straight, right is gentle."
                              ToolTip="The middle is straight. Toward Eager the output rises early in the press, toward Gentle it rises late." />
                      <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                        <ui:TextBlock Style="{StaticResource CardSummary}" HorizontalAlignment="Left" Text="Eager" />
                        <ui:TextBlock Style="{StaticResource CardSummary}" HorizontalAlignment="Center" Text="Straight" />
                        <ui:TextBlock Style="{StaticResource CardSummary}" HorizontalAlignment="Right" Text="Gentle" />
                      </Grid>
                      <ui:TextBlock Grid.Row="2" VerticalAlignment="Center" Margin="0,0,12,0" Text="{Binding SaturationName}" />
                      <Slider Grid.Row="2" Grid.Column="1" Style="{StaticResource FractionSlider}" Minimum="0.05" Value="{Binding Saturation}"
                              AutomationProperties.Name="{Binding SaturationName}" AutomationProperties.ItemStatus="{Binding Saturation, StringFormat=P0}"
                              AutomationProperties.HelpText="How far the key goes before the output, or in Rate mode the stick's speed, is full."
                              ToolTip="How far the key goes before the output, or in Rate mode the stick's speed, is full." />
                      <ui:TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource SliderValue}" Text="{Binding Saturation, StringFormat=P0}" />
                      <ui:TextBlock Grid.Row="3" VerticalAlignment="Center" Margin="0,0,12,0" Text="Dead zone" />
                      <Slider Grid.Row="3" Grid.Column="1" Style="{StaticResource FractionSlider}" Maximum="0.5" Value="{Binding Deadzone}"
                              AutomationProperties.Name="Dead zone" AutomationProperties.ItemStatus="{Binding Deadzone, StringFormat=P0}"
                              AutomationProperties.HelpText="How far the key goes before there is any output." ToolTip="How far the key goes before there is any output." />
                      <ui:TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource SliderValue}" Text="{Binding Deadzone, StringFormat=P0}" />
                    </Grid>
                    <ui:InfoBar Style="{StaticResource Warning}" Message="{Binding DeadzoneProblem}" views:Live.Text="{Binding DeadzoneProblem}"
                                Visibility="{Binding DeadzoneProblem, Converter={StaticResource ShowWhenPresent}}" />

                    <WrapPanel>
                      <StackPanel Margin="0,0,16,0">
                        <ui:TextBlock Style="{StaticResource FieldLabel}" Text="Press ramp, ms" />
                        <ui:NumberBox Style="{StaticResource Milliseconds}" Value="{Binding PressRampMs, Mode=TwoWay}"
                                      AutomationProperties.Name="Press ramp, milliseconds" AutomationProperties.HelpText="The shortest time the output takes to go from none to full. 0 follows the key directly." ToolTip="The shortest time the output takes to go from none to full. 0 follows the key directly." />
                      </StackPanel>
                      <StackPanel>
                        <ui:TextBlock Style="{StaticResource FieldLabel}" Text="Release ramp, ms" />
                        <ui:NumberBox Style="{StaticResource Milliseconds}" Value="{Binding ReleaseRampMs, Mode=TwoWay}"
                                      AutomationProperties.Name="Release ramp, milliseconds" AutomationProperties.HelpText="The shortest time the output takes to go from full to none. 0 follows the key directly." ToolTip="The shortest time the output takes to go from full to none. 0 follows the key directly." />
                      </StackPanel>
                    </WrapPanel>

                    <StackPanel Visibility="{Binding IsAxis, Converter={StaticResource ShowWhenTrue}}">
                      <ui:TextBlock Style="{StaticResource FieldLabel}" Text="Stick movement" />
                      <ComboBox ItemsSource="{x:Static vm:BindingRowViewModel.Modes}" SelectedValuePath="Value" DisplayMemberPath="Name"
                                SelectedValue="{Binding Mode}" Width="260" HorizontalAlignment="Left" AutomationProperties.Name="Stick movement" />
                      <ui:TextBlock Margin="0,8,0,0" Style="{StaticResource Note}" Text="{Binding ModeText}" views:Live.Text="{Binding ModeText}" />
                      <WrapPanel Visibility="{Binding IsRateMode, Converter={StaticResource ShowWhenTrue}}">
                        <StackPanel Margin="0,0,16,0">
                          <ui:TextBlock Style="{StaticResource FieldLabel}" Text="Centre to edge, ms" />
                          <ui:NumberBox Style="{StaticResource Milliseconds}" Minimum="1" Value="{Binding RateMs, Mode=TwoWay}"
                                        AutomationProperties.Name="Centre to edge, milliseconds" AutomationProperties.HelpText="How long a fully pressed key takes to move the stick from centre to the edge" ToolTip="How long a fully pressed key takes to move the stick from centre to the edge" />
                        </StackPanel>
                        <StackPanel>
                          <ui:TextBlock Style="{StaticResource FieldLabel}" Text="Edge to centre, ms" />
                          <ui:NumberBox Style="{StaticResource Milliseconds}" Value="{Binding ReturnMs, Mode=TwoWay}"
                                        AutomationProperties.Name="Edge to centre, milliseconds" AutomationProperties.HelpText="How long the stick takes to go from the edge back to centre once the keys are released" ToolTip="How long the stick takes to go from the edge back to centre once the keys are released" />
                        </StackPanel>
                      </WrapPanel>
                      <ui:TextBlock Style="{StaticResource FieldLabel}" Text="When both keys are held" />
                      <ComboBox ItemsSource="{x:Static vm:BindingRowViewModel.Conflicts}" SelectedValuePath="Value" DisplayMemberPath="Name"
                                SelectedValue="{Binding Conflict}" Width="260" HorizontalAlignment="Left" AutomationProperties.Name="When both keys are held" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>

                <ui:Button Margin="0,16,0,0" Icon="{ui:SymbolIcon Delete24}" Content="Remove this binding" Command="{Binding DataContext.Remove, ElementName=Root}" />
              </StackPanel>
            </StackPanel>
          </ui:CardExpander>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
